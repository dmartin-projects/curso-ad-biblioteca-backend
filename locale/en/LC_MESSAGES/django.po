msgstr "No session."

#: usuarios/api/serializers.py:49
msgid "La contraseña actual no es correcta."
msgstr "The current password is not correct."

#: usuarios/api/views.py:59
msgid "Revisa tu email: te hemos enviado un enlace para continuar."
msgstr "Check your email: we have sent you a link to continue."

#: usuarios/api/views.py:101
